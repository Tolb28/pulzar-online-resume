{
  "name": "pulzar-cv",
  "version": "0.1.0",
  "private": true,
  "description": "Pulzar CV – online životopis (cv.pulzarstudio.cz)",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "test": "npm run build:client && vitest run",
    "test:watch": "vitest",
    "fonts": "python3 scripts/build-fonts.py",
    "db:migrate:local": "wrangler d1 migrations apply pulzar-cv --local",
    "db:migrate:remote": "wrangler d1 migrations apply pulzar-cv --remote",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "fflate": "0.8.3",
    "hono": "4.13.21",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261124.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/manrope": "0.4.3",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "0.4.2",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@types/node": "22.19.1",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.168.0"
  }
}
